# Copy this file to .env and fill in real values
PORT=5000
# Local MongoDB:      mongodb://127.0.0.1:27017/nec_clubconnect
# MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nec_clubconnect
MONGODB_URI=mongodb+srv://mathanraji281_db_user:meera22@project.thbivdr.mongodb.net/
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Frontend origin(s) allowed by CORS (comma separated)
CLIENT_ORIGIN=http://localhost:5173
# Google OAuth (real sign-in). Create an OAuth 2.0 Client ID (Web application) in
# Google Cloud Console, add your site to "Authorized JavaScript origins", and put
# the client id here AND in frontend/.env as VITE_GOOGLE_CLIENT_ID.
# Leave empty to disable Google sign-in (the app then uses the offline demo dialog).
GOOGLE_CLIENT_ID=
# First Super Admin (created by `npm run seed`). Change the password after first login.
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@nec.edu.in
SUPERADMIN_PASSWORD=ChangeMe@123
